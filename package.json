  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~57.0.13",
    "expo-audio": "^57.0.3",
    "expo-haptics": "^57.0.1",
    "expo-status-bar": "~57.0.1",
