{
  "name": "morse-tap",
  "version": "0.0.30",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "tsx --test src/morse.test.ts src/settings.test.ts src/storage.test.ts",
    "typecheck": "tsc --noEmit",
    "test:server": "cd server && npm install && node --test test.js delivery.test.js duplicate.test.js",
    "test:sim": "for f in sim/*.sim.ts sim/*.sim.mts; do echo \"--- $f\"; tsx $f || exit 1; done",
    "build:web": "node scripts/build-web.mjs",
    "web:build": "node web/publish.mjs",
    "test:web": "tsx sim/webapp.sim.mts",
    "build:ios": "eas build --platform ios --profile production",
    "submit:ios": "eas submit --platform ios --latest"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~54.0.35",
    "expo-audio": "~1.1.1",
    "expo-haptics": "~15.0.8",
    "expo-keep-awake": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "~19.1.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "~5.9.2"
  },
  "private": true
}
